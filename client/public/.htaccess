# Breakwaters Recruiting — Apache config for Hostinger shared hosting.
# Order matters: host/HTTPS canonicalisation, headers, caching, then routing.

# ---- Canonical host + HTTPS (one 301). Also catches www. and the old
#      breakwatersrecruiting.co.za domain if it is parked on this account. ----
RewriteEngine On
RewriteBase /
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^breakwatersrecruitment\.co\.za$ [NC]
RewriteRule ^ https://breakwatersrecruitment.co.za%{REQUEST_URI} [R=301,L]

# ---- Security headers ----
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Allows GA4 (the inline gtag snippet is hash-listed: rehash if you edit it in
  # index.html) and Google Fonts; everything else same-origin.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-WDcsOuM4CAG1ZiErvlUR9RZGBGkgTE3SzhN6AttHgZo=' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# ---- Compression ----
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>

# ---- Caching: hashed assets forever, HTML always revalidated ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^.+\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Routing ----
# Real files (contact.php, assets, sitemap) are served as-is.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
# Prerendered routes: /about -> /about/index.html, no trailing-slash redirect.
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([a-z-]+)/?$ /$1/index.html [L]
# Anything else is an unknown path: let the SPA show the home redirect.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
